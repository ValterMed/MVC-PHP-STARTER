{
    "name": "mvc-php-starter/app",
    "description": "Aplicación MVC simple en PHP sin framework",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpunit/php-file-iterator": true
        }
    }
}